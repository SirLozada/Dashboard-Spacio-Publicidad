# Copia este archivo como referencia de las variables disponibles.
PORT=3000
NODE_ENV=production
# Carpeta donde se guardan la base de datos y los archivos adjuntos (debe ser persistente)
DATA_DIR=./data
# Zona horaria para calcular trabajos atrasados
TZ=America/Caracas
# Usuario administrador inicial (sólo se usa la primera vez que arranca el sistema)
ADMIN_USUARIO=fernando
ADMIN_NOMBRE=Fernando
ADMIN_PASSWORD=cambia-esta-clave
# Clave para firmar sesiones (si no se indica, se genera una y se guarda en DATA_DIR)
JWT_SECRET=
# Opciones de la aplicación
PREFIJO_TRABAJO=SP-
MONEDA=USD
DIAS_ALERTA=3
MAX_ARCHIVO_MB=25
