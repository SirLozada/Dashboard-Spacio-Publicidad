# Copia este archivo como referencia de las variables disponibles.
PORT=3000
NODE_ENV=production
# --- Vercel: las crean automáticamente las integraciones de Turso y Vercel Blob ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
# public (por defecto) o private, según cómo se creó el almacén Blob
BLOB_ACCESS=public

# --- Servidor propio: sin Turso/Blob se usa esta carpeta (debe ser persistente) ---
DATA_DIR=./data
# Zona horaria para calcular trabajos atrasados
ZONA_HORARIA=America/Caracas
# Usuario administrador inicial (sólo se usa la primera vez que arranca el sistema)
ADMIN_USUARIO=fernando
ADMIN_NOMBRE=Fernando
ADMIN_PASSWORD=cambia-esta-clave
# Clave para firmar sesiones (si no se indica, se genera una y se guarda en la base de datos)
JWT_SECRET=
# Opciones de la aplicación
PREFIJO_TRABAJO=SP-
MONEDA=USD
DIAS_ALERTA=3
MAX_ARCHIVO_MB=25
