{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{server/migrations/**,datos-iniciales/**,public/js/lib/**,public/img/logo-oscuro.png,public/img/logo-claro.png,node_modules/pdfkit/js/data/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:ruta*",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/tasa-bcv/cron",
      "schedule": "5 13 * * *"
    },
    {
      "path": "/api/tasa-bcv/cron-tarde",
      "schedule": "5 22 * * *"
    }
  ]
}
