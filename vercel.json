{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{server/migrations/**,datos-iniciales/**}"
    }
  },
  "rewrites": [{ "source": "/api/:ruta*", "destination": "/api" }]
}
